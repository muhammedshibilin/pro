# Database connection string (SQLite file by default, or PostgreSQL / Supabase / Neon)
DATABASE_URL="file:./dev.db"

# Next.js Full Stack relative API path
NEXT_PUBLIC_API_URL="/api"

# Cloudinary Storage Configuration (Optional for local, required for live Cloudinary upload)
# Sign up free at https://cloudinary.com and paste keys below:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
